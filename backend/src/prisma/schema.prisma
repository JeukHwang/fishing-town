// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DB_URL")
}

enum GameStatus {
  Waiting
  Playing
  Finished
}

model User {
  id        String    @id @default(nanoid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshToken String?

  email    String @unique
  password String
  name     String @unique

  hostGames Game[]
  players   Player[]
}

model Game {
  id        String    @id @default(nanoid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  hostId String
  host   User   @relation(fields: [hostId], references: [id])

  status GameStatus @default(Waiting)
  rule   Json?

  players Player[]
}

model Player {
  id        String    @id @default(nanoid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])
  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  money Int @default(0)
  ship  Int @default(0)

  townId String
  town   Town   @relation(fields: [townId], references: [id])
  clubs  Club[]
}

model Town {
  id        String    @id @default(nanoid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name String @unique
  rule Json // TownRule

  clubs   Club[]
  players Player[]
}

model Club {
  id        String    @id @default(nanoid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  townId String
  town   Town   @relation(fields: [townId], references: [id])

  name String @unique
  rule Json // ClubRule

  players Player[]
}
